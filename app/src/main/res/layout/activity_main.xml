<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_circuit"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp">

    <!-- Top of screen: RAM dial, memory figures, cleaning dial (layout differs on phone vs TV) -->
    <include layout="@layout/header" />

    <LinearLayout
        android:id="@+id/statusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="8dp"
            android:textColor="@color/text_main"
            android:textSize="15sp" />

        <!-- First screen: choose Basic Clean or Rapid Total Clean -->
        <LinearLayout
            android:id="@+id/choiceBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/basicButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_small_button"
                android:minHeight="72dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/text_main" />

            <TextView
                android:id="@+id/basicDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/text_dim"
                android:textSize="14sp" />

            <com.rickyboy.appsweep.SpeedButton
                android:id="@+id/rapidButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_small_button"
                android:minHeight="72dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/text_main" />

            <TextView
                android:id="@+id/rapidDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/text_dim"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Setup step 1: what App Closer looks like in Accessibility while it's still blocked -->
        <LinearLayout
            android:id="@+id/stepImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_settings_mock"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/stepImageIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="16dp"
                android:alpha="0.45"
                android:contentDescription="App Closer icon"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/stepImageTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="App Closer"
                    android:textColor="#80FFFFFF"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/stepImageSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="Controlled by Restricted Setting"
                    android:textColor="#66FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/stepImageHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👆"
                android:textSize="24sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="8dp"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/statusButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_small_button"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/neon_cyan"
                android:textStyle="bold" />

            <Button
                android:id="@+id/statusButton2"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_small_button"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/neon_cyan"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/codeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/codeInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_small_button"
                android:hint="6-digit pairing code"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="6"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_dim"
                android:textSize="18sp" />

            <Button
                android:id="@+id/pairButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_small_button"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:stateListAnimator="@null"
                android:text="Pair"
                android:textAllCaps="false"
                android:textColor="@color/neon_cyan"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/shizukuButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:background="@android:color/transparent"
            android:stateListAnimator="@null"
            android:text="Already use Shizuku? Use it instead"
            android:textAllCaps="false"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/linkButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_small_button"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/neon_cyan"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp">

        <Button
            android:id="@+id/sweepButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="76dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
                    android:background="@drawable/bg_sweep_button"
            android:enabled="false"
            android:alpha="0.4"
            android:fontFamily="@font/rajdhani_bold"
            android:letterSpacing="0.05"
            android:shadowColor="#AA35D7FF"
            android:shadowRadius="10"
            android:stateListAnimator="@null"
            android:text="@string/sweep_button"
            android:textColor="@color/text_main"
            android:textSize="21sp" />

        <!-- Shown for a few seconds after a sweep, in place of the button -->
        <LinearLayout
            android:id="@+id/allCleanView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="170dp"
                android:adjustViewBounds="true"
                android:contentDescription="All clean"
                android:src="@drawable/all_clean_ram" />

            <TextView
        android:shadowColor="#FF00E676"
        android:shadowRadius="12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="All clean!"
                android:textColor="@color/text_main"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Rapid Total Clean (Developer options): the upgrade, with fire either side -->
    <com.rickyboy.appsweep.SpeedButton
        android:id="@+id/instantLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/rajdhani_bold"
        android:gravity="center"
        android:letterSpacing="0.05"
        android:minHeight="84dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:shadowColor="#AAFF7A18"
        android:shadowRadius="10"
        android:stateListAnimator="@null"
        android:textAllCaps="false"
        android:textColor="@color/text_main"
        android:textSize="22sp"
        android:visibility="gone" />
    <!-- TV only: optional one-time switch that makes closing fully automatic -->
    <Button
        android:id="@+id/tvAutoButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_small_button"
        android:stateListAnimator="@null"
        android:text="Make closing automatic"
        android:textAllCaps="false"
        android:textColor="@color/text_main"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/resultRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_plain"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
        android:shadowColor="#00000000"
        android:shadowRadius="12"
                android:id="@+id/statClosed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/rajdhani_bold"
                android:text="0"
                android:textColor="@color/text_main"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/rajdhani_bold"
                android:letterSpacing="0.06"
                android:text="APPS CLOSED"
                android:textColor="@color/neon_blue"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_plain"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
        android:shadowColor="#00000000"
        android:shadowRadius="12"
                android:id="@+id/statRam"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/rajdhani_bold"
                android:text="0"
                android:textColor="@color/text_main"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/rajdhani_bold"
                android:letterSpacing="0.06"
                android:text="RAM FREED"
                android:textColor="@color/accent_green"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_plain"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
        android:shadowColor="#00000000"
        android:shadowRadius="12"
                android:id="@+id/statCache"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/rajdhani_bold"
                android:text="0"
                android:textColor="@color/text_main"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/rajdhani_bold"
                android:letterSpacing="0.06"
                android:text="CACHE CLEARED"
                android:textColor="@color/neon_violet"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:shadowColor="#00000000"
        android:shadowRadius="12"
        android:id="@+id/resultText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/text_dim"
        android:textSize="13sp"
        android:textStyle="normal"
        android:visibility="gone" />

    <TextView
        android:shadowColor="#00000000"
        android:shadowRadius="12"
        android:id="@+id/statsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="@color/neon_cyan"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/listPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/listHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/rajdhani_bold"
            android:letterSpacing="0.06"
            android:text="RUNNING APPS"
            android:textColor="@color/text_main"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/listHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/share_tech_mono"
            android:text="Biggest RAM users first · Tap an app for options · Hold to close it"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:paddingBottom="6dp" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="18dp" />

</LinearLayout>
</androidx.core.widget.NestedScrollView>
